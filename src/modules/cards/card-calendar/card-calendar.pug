mixin card-calendar
    .card.card-calendar
      .card-inner.card-calendar-inner
        button.card-calendar__btn
          span.material-icons.card-calendar__arrow-prev arrow_forward 
        h3.card-calendar__title Август 2019
        button.card-calendar__btn
          span.material-icons.card-calendar__arrow-next arrow_forward 
        main.card-calendar__main 
          .card-calendar__main__days 
            - 
              var days = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс']
            each day in days 
              div.calendar__item #{day}
          .card-calendar__main__numbers
            div.calendar__item.card-calendar__main__number.card-calendar__main__number_unactual 29
            div.calendar__item.card-calendar__main__number.card-calendar__main__number_unactual 30
            div.calendar__item.card-calendar__main__number.card-calendar__main__number_unactual 31
