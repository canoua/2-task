include ../../buttons/button-white/button-white.pug
include ../../buttons/button-gradient-arrow/button-gradient-arrow.pug
include ../../radiobuttons/radiobuttons.pug
include ../../toggle/toggle.pug
include ../../text-field/text-field-default/text-field-default.pug
include ../../text-field/text-field-masked/text-field-masked.pug
include ../card__note/card__note.pug

mixin card-sign-up 
  form(action="#") 
    .card
      .card-inner 
        h1.card__title Регистрация аккаунта
        .inputs-wrapper 
          +text-field-default('', '', '', 'Имя')
          +text-field-default('', '', '', 'Фамилия')
        +radiobuttons('')
        +text-field-masked('', 'дата рождения', 'ДД.ММ.ГГГГ')
        +text-field-default('', 'данные для входа в сервис', '', 'Email')
        +text-field-default('', '', '', 'Пароль')
        +toggle('Получать спецпредложения')
        +btn-gradient-arrow('', 'перейти к оплате')
        +card__note('sign-up')