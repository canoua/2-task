include ../../buttons/button-white/button-white.pug
include ../../buttons/button-gradient-arrow/button-gradient-arrow.pug
include ../../text-field/text-field-default/text-field-default.pug
include ../card__note/card__note.pug

mixin card-sign-in
  form(action="#") 
    .card
      .card-inner
        h1.card__title Войти
        .inputs-wrapper.card-sign-in__inputs-wrapper 
          +text-field-default('', '', '', 'Email')
          +text-field-default('', '', '', 'Пароль')
        +btn-gradient-arrow('button-default-big', 'Войти')
        +card__note('sign-in')