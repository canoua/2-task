include ../../buttons/buttons.pug
include ../../dropdown/dropdown.pug

mixin card-landing 
  form(action="#")
    .card.app-js-dropdown.card 
      .card-inner  
        h1.card__title Найдём номера под ваши пожелания
        .card-landing__date-dropdown-wrapper
          +date-dropdown('input1','прибытие', 'ДД.ММ.ГГГГ')
          +date-dropdown('input2','выезд', 'ДД.ММ.ГГГГ')
        .dropdown-page.dropdown-expanded-guests__form
          +dropdown('card-landing__dropdown card-landing__dropdown-js', 'гости', 'Сколько гостей')
          .fe__dropdown__content
            ul.dropdown-list.dropdown-expanded-guests__list  
              //- - 
              //-   const dropdownExpandedGuestsList = [
              //-     {name: 'взрослые', number: 2},
              //-     {name: 'дети', number: 2},
              //-     {name: 'младенцы', number: 2},
              //-   ]
          
              li.dropdown-list__item 
                .dropdown-list__item_name взрослые
                .dropdown-list__count 
                  .dropdown-list__count_minus -
                  .dropdown-list__count_number.dropdown__guests-list__count_number 2
                  .dropdown-list__count_plus +
              li.dropdown-list__item 
                .dropdown-list__item_name дети
                .dropdown-list__count 
                  .dropdown-list__count_minus -
                  .dropdown-list__count_number.dropdown__guests-list__count_number 2
                  .dropdown-list__count_plus +
              li.dropdown-list__item 
                .dropdown-list__item_name младенцы
                .dropdown-list__count 
                  .dropdown-list__count_minus.unactive-element -
                  .dropdown-list__count_number.dropdown__guests-list__count_number 0
                  .dropdown-list__count_plus +
            .dropdown-btns.dropdown-btns-2  
              button.dropdown__reset(type="reset") Очистить 
              button.dropdown__submit(type="submit") Применить  
        +btn-gradient-arrow('card-btn-landing', 'подобрать номер')

         
          