mixin card-room-arrow 
  .card.card-room
    .card-inner.card-room-inner
      .card-room__slider
        .slide.card-room__slide 
          img(src=require('@images/cards/slide-2.png'), alt="slide-1")
        .pagination
          .dot.dot_active 
          .dot 
          .dot 
          .dot 
        .arrow-prev.material-icons expand_more
        .arrow-next.material-icons expand_more
      .card-room__content
        .card-room__content__header 
          h3.card-room__title 
            .card-room__title__number № 888
            .card-room__title__text люкс
          .card-room__price 
            .card-room__price__number 9 900₽ 
            .card-room__price__text в сутки
        .card-room__content__footer 
          .stars-ratings 
            span.material-icons.material-icons-star star
            span.material-icons.material-icons-star star
            span.material-icons.material-icons-star star
            span.material-icons.material-icons-star star
            span.material-icons.material-icons-star star
          .card-room__reviews 
            .card-room__reviews__number 145
            .card-room__reviews__text Отзывов