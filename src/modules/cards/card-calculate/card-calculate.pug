include ../../dropdowns/date-dropdown/date-dropdown.pug
include ../../dropdowns/dropdown/dropdown.pug
include ../../buttons/button-gradient-arrow/button-gradient-arrow.pug

mixin card-calculate(dropdownClass)
  form(action="#")
    .card.card-calculate 
      .card-inner 
        .card-calculate__header 
          .card-calculate__room
            span.card-calculate__room__icon №
            span.card-calculate__room__number 888
            span.card-calculate__room__class люкс
          .card-calculate__price
            span.card-calculate__price__values 9 990₽
            span.card-calculate__price__duration в сутки
        .date-dropdown-wrapper
          +date-dropdown('прибытие', '19.08.2019')
          +date-dropdown('выезд', '23.08.2019')
        +dropdown(dropdownClass, 'гости', '3 гостя')
        .card-calculate__count-wrapper
          .card-calculate__count 
            span 9 990₽ х 4 суток
            span 39 960₽
          .card-calculate__count 
            span.card-calculate__count__info Сбор за услуги: скидка 2 179₽
            span 0₽
          .card-calculate__count 
            span.card-calculate__count__info Сбор за дополнительные услуги
            span 300₽
        .card-calculate__result 
          span.card-calculate__result__item Итого
          span.card-calculate__result__item 38 081₽
        +btn-gradient-arrow('card-btn-landing', 'забронировать')
        
