include ../../dropdown/dropdown.pug
include ../../buttons/buttons.pug

mixin card-calculate(dropdownClass)
  form(action="#")
    .app-js-dropdown.card.card-calculate 
      .card-inner 
        .card-calculate__header 
          .card-calculate__room
            span.card-calculate__room__icon №
            span.card-calculate__room__number 888
            span.card-calculate__room__class люкс
          .card-calculate__price
            span.card-calculate__price__values 9 990₽
            span.card-calculate__price__duration в сутки
        .card-calculate__date-dropdown-wrapper
          +date-dropdown('прибытие', '19.08.2019')
          +date-dropdown('выезд', '23.08.2019')
        .dropdown-page.dropdown-expanded-guests__form
          +dropdown('dropdown-page card-landing__dropdown-js', 'гости', 'Сколько гостей')
          .fe__dropdown__content
            //- в миксин или в цикл
            ul.dropdown-list.dropdown-expanded-guests__list  
              li.dropdown-list__item 
                .dropdown-list__item_name взрослые
                .dropdown-list__count 
                  .dropdown-list__count_minus.dropdown-list__count_minus-js -
                  .dropdown-list__count_number.dropdown__guests-list__count_number 2
                  .dropdown-list__count_plus.dropdown-list__count_plus-js +
              li.dropdown-list__item 
                .dropdown-list__item_name дети
                .dropdown-list__count 
                  .dropdown-list__count_minus.dropdown-list__count_minus-js -
                  .dropdown-list__count_number.dropdown__guests-list__count_number 2
                  .dropdown-list__count_plus.dropdown-list__count_plus-js +
              li.dropdown-list__item 
                .dropdown-list__item_name младенцы
                .dropdown-list__count 
                  .dropdown-list__count_minus.dropdown-list__count_minus-js.unactive-element -
                  .dropdown-list__count_number.dropdown__guests-list__count_number 0
                  .dropdown-list__count_plus.dropdown-list__count_plus-js +
            .dropdown-btns.dropdown-btns-2  
              button.dropdown__reset(type="reset") Очистить 
              button.dropdown__submit(type="submit") Применить  
        .card-calculate__count-wrapper
          .card-calculate__count 
            span 9 990₽ х 4 суток
            span 39 960₽
          .card-calculate__count 
            span.card-calculate__count__info Сбор за услуги: скидка 2 179₽
            span 0₽
          .card-calculate__count 
            span.card-calculate__count__info Сбор за дополнительные услуги
            span 300₽
        .card-calculate__result 
          span.card-calculate__result__item Итого
          span.card-calculate__result__item 38 081₽
        +btn-gradient-arrow('card-btn-landing', 'забронировать')
        
