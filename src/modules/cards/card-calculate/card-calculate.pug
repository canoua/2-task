include ../../dropdown/dropdown.pug
include ../../buttons/buttons.pug

mixin card-calculate(dropdownClass)
  form(action="#")
    .app-js-dropdown.card.card-calculate 
      .card-inner 
        .card-calculate__header 
          .card-calculate__room
            span.card-calculate__room-icon №
            span.card-calculate__room-number 888
            span.card-calculate__room-class люкс
          .card-calculate__price
            span.card-calculate__price-values 9 990₽
            span.card-calculate__price-duration в сутки
        .card-calculate__date-dropdown-wrapper
          +date-dropdown('input1','прибытие', '19.08.2019')
          +date-dropdown('input2','выезд', '23.08.2019')
        .dropdown-page.dropdown-expanded-guests__form
          +dropdown('rd-dropdown', 'rd-dropdown', 'гости', '3 гостя')
          .fe__dropdown-content
            - 
              const guests = [
                {name: 'взрослые', count: 2},
                {name: 'дети', count: 2},
                {name: 'младенцы', count: 0}
              ]
            ul.dropdown-list.dropdown-expanded-guests__list  
              each guest in guests 
                li.dropdown-list__item 
                  .dropdown-list__item_name #{guest.name}
                  .dropdown-list__count 
                    .dropdown-list__count_minus.dropdown-list__count_minus-js -
                    .dropdown-list__count_number.dropdown__guests-list__count_number #{guest.count}
                    .dropdown-list__count_plus.dropdown-list__count_plus-js +
            .dropdown-btns.dropdown-btns-2  
              button.dropdown__reset(type="reset") Очистить 
              button.dropdown__submit(type="submit") Применить  
        .card-calculate__count-wrapper
          .card-calculate__count 
            span 9 990₽ х 4 суток
            span 39 960₽
          .card-calculate__count 
            span.card-calculate__count-info Сбор за услуги: скидка 2 179₽
            span 0₽
          .card-calculate__count 
            span.card-calculate__count-info Сбор за дополнительные услуги
            span 300₽
        .card-calculate__result 
          span.card-calculate__result-item Итого
          span.card-calculate__result-item 38 081₽
        +btn-gradient-arrow('card-btn-landing', 'забронировать')
        