include ../input-card/input-card.pug

mixin text-field-default(className, title, status, placeholder)
  .text-field-default(class=className)
    .text-field-default__header
      h3.h3=title 
      span.text-field-default__state=status
    +input-card('', placeholder)

mixin text-field-hover(className, title, status, placeholder)
  .text-field-hover(class=className)
    .text-field-default__header
      h3.h3=title  
      span.text-field-default__state=status
    +input-card('card__input-hover', placeholder)

mixin text-field-masked(className, title, placeholder)
  .text-field-default(class=className) 
    .text-field-default__header
      h3.h3=title
    +input-card('card__input-masked', placeholder)

mixin subscription-text-field(className, title, placeholder)
  .subscription-text-field(class=className)
    .subscription-text-field__header
      h3.h3=title
    .subscription-text-field__input-wrapper 
      input.subscription-text-field__input(type="text" placeholder=placeholder)
      button.subscription-text-field__input__button 
        span.material-icons.material-icons-arrow-blue arrow_forward
