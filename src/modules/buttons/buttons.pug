mixin button-gradient(btnGradientClass,textGradient)
  if textGradient=='Зарегистрироваться'
    a(href="/pages/sign-up.html" class=btnGradientClass target='_about').button.button-default.header__btn-border=textGradient
  else 
    //-для страницы form-elements
    button(class=btnGradientClass).button.button-default.header__btn-border=textGradient
mixin btn-gradient-arrow(classes, textGradBtn)
  button.button-default-big(class=classes)
    span=textGradBtn
    .material-icons.material-icons-arrow_forward arrow_forward 

mixin like-button(classIcon, nameBtn, icon, text)   
  .like-button__item(class=nameBtn) 
    span(class=classIcon).material-icons.like-icon=icon
    span.like-button__item-text=text

mixin button-white(btnClass,text)
  if text=='Войти'
    a(href='/pages/sign-in.html' class=btnClass target='_about').button.button-border.header__btn-white=text
  else 
    //-для страницы form-elements
    button(class=btnClass).button.button-border.header__btn-white=text
