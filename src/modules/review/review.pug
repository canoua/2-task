mixin review(source, name, date, icon, icontext, text)
  .review
    .review__header  
      .review__avatar 
        img.review__avatar-image(src=source alt="avatar")
      .review__name-wrapper
        .review__name=name 
        .review__date=date 
    .review__content 
      .like-button__item.like-button__item-favorite 
        span.material-icons.material-icons-favorite.like-icon=icon 
        span.like-button__item-text=icontext 
      .review__text=text 
