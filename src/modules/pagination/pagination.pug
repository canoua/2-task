mixin pagination  
  ul.pagination__list
    li.pagination__list_item 
      a.pagination__link.pagination__link-active(href="#") 1
    li.pagination__list_item
      a.pagination__link(href="#") 2
    li.pagination__list_item 
      a.pagination__link(href="#") 3 
    li.pagination__list_item 
      a.pagination__link(href="#") ... 
    li.pagination__list_item
      a.pagination__link(href="#") 15 
    li.pagination__list_item
      a.pagination__link.pagination__link-arrow(href="#")
        span.material-icons.material-icons-pagination-link arrow_forward 
  .pagination__info 1 – 12 из 100+ вариантов аренды