include includes.pug 
+includes

doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(http-equiv="X-UA-Compatible", content="IE=edge")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title cards
  body 
    .ui-cards 
      .container 
        .ui-cards__logo
          img(src=require("@images/ui-logo.svg"), alt="ui-logo")
        .ui-cards-inner 
          .col.col_1
            .ui-card
              +card-landing
            .ui-card
              +card-sign-up("cards")
          .col.col_2
            .ui-card 
              +card-calculate
            .ui-card
              +card-sign-in
          .col.col_3
            .ui-card 
              +card-calendar
            .ui-card 
              +card-room(require('@images/cards/slide-2.png'), 888, '9 990Р', 5, 145)
            .ui-card  
              +card-room(require('@images/cards/slide-1.png'), 840, '9 900Р', 4, 65)
