include includes.pug
+includes

mixin fe-inner-3   
  .container.fe-inner-3
    .column
      //- вынести в миксин
      .expandable-checkbox-list-default.fe__item
        .checkbox__header.fe__item_header
          h3.h3 expandable checkbox list
          span.material-icons.material-icons-expand expand_more
      .expandable-checkbox-list-expanded.fe__item
        .checkbox__header.fe__item_header
          h3.h3 expandable checkbox list
          span.material-icons.material-icons-expand.material-icons-expand-reverse expand_more
        //- сделать миксин
        ul.checkbox__list 
          li.checkbox__list_item 
            +checkbox('', 'breakfast', 'Завтрак')
          li.checkbox__list_item  
            +checkbox('', 'desk', 'Письменный стол')
          li.checkbox__list_item  
            +checkbox('', 'chair-for-feeding', 'Стул для кормления')
          li.checkbox__list_item  
            +checkbox('', 'crib', 'Кроватка')
          li.checkbox__list_item  
            +checkbox('', 'television', 'Телевизор')
          li.checkbox__list_item  
            +checkbox('', 'shampoo', 'Шампунь')
    .column.column-2  
      .rich-checkbox-buttons.fe__item 
        .checkbox-buttons__header.fe__item_header
          h3.h3 Rich Checkbox Buttons
        ul.checkbox__list 
          li.checkbox__list-item.rich-checkbox__list-item 
            +checkbox('checkbox__list-label-rich-title', 'corridor', 'Широкий коридор')
            .checkbox__list-label-rich-info Ширина коридоров в номере не менее 91 см.
          li.checkbox__list-item.rich-checkbox__list-item   
            +checkbox('checkbox__list-label-rich-title', 'assistant', 'Помощник для инвалидов')
            .checkbox__list-label-rich-info На 1 этаже вас встретит специалист и проводит до номера.
    .column.column-3   
      .bullet.fe__item 
        h3.h3 bullet list
        +bullet-list('Нельзя с питомцами', 'Без вечеринок и мероприятий', 'Время прибытия — после 13:00, а выезд до 12:00')
