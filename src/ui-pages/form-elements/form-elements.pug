include includes.pug 
+includes

doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(http-equiv="X-UA-Compatible", content="IE=edge")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title form-elements
  body 
    .elements 
      .elements__logo
        include ./../../assets/images/ui-logo.svg
      .container.elements-inner-1
        .column 
          +text-field-default('Text Field', 'Default', 'Email')
          +text-field-hover('Text Field', 'Hover / Focus', 'This is pretty awesome')
          +dropdown('dropdown-ui','Dropdown', 'Сколько гостей')
          +text-field-masked('masked text field')
          .date-dropdown-wrapper 
            +date-dropdown('date Dropdown', 'ДД.ММ.ГГГГ')
            +date-dropdown('date Dropdown', '19.08.2019')
          +filter-date-dropdown('elements__item ', 'filter date dropdown', '19 авг - 23 авг')
          +subscription-text-field('subscription text field', 'Email')
        .column 
          .checkbox-buttons.elements__item 
            .checkbox-buttons__header.elements__item_header
              h3.h3 Checkbox Buttons
            ul.checkbox__list 
              li.checkbox__list_item 
                +checkbox('', 'smoking','Можно курить')
              li.checkbox__list_item  
                +checkbox('', 'pets','Можно с питомцами')
              li.checkbox__list_item 
                +checkbox('', 'guests', 'Можно пригласить гостей (до 10 человек)') 
          .radiobuttons.elements__item 
            .elements__item_header.radiobuttons__header
              h3.h3 Radio Buttons
            +radiobuttons('')
          .toggle.elements__item 
            .toggle__header.elements__item_header
              h3.h3 Toggle
            +toggle('Получать спецпредложения')
            +toggle('Получать спецпредложения')
          .like-button.elements__item 
            .elements__item_header.like-button__header
              h3.h3 like button
            .like-button-inner 
              +like-button('material-icons-favorite-border','favorite_border', '2')
              +like-button('material-icons-favorite','favorite', '12')
          .rate-button.elements__item 
            .elements__item_header.rate-button__header
              h3.h3 rate button
            .stars-ratings-wrapper 
              .stars-ratings 
                span.material-icons.material-icons-star star
                span.material-icons.material-icons-star star
                span.material-icons.material-icons-star star
                span.material-icons.material-icons-star star
                span.material-icons.material-icons-star star_border
              .stars-ratings 
                span.material-icons.material-icons-star star
                span.material-icons.material-icons-star star
                span.material-icons.material-icons-star star
                span.material-icons.material-icons-star star
                span.material-icons.material-icons-star star
        .column
          +range-slider('', 'range slider')
          .buttons.elements__item 
            .elements__item_header.buttons__header
              h3.h3 buttons
            .buttons-content 
              .button-default-wrapper 
                +button-gradient('form-element-btn', 'CLICK ME')
                button.button.button-default.button-default-hover.form-element-btn CLICK ME
              //-class?????????
              .button-border-hover-wrapper 
                +button-white('form-element-btn', 'CLICK ME')
                button.button.button-border.button-border-hover.form-element-btn CLICK ME
              .icon-link-wrapper 
                a(href="#").icon-link CLICK ME
                a(href="#").icon-link.icon-link-hover CLICK ME
              +btn-gradient-arrow('', 'перейти к оплате')
          .pagination.elements__item 
            .elements__item_header.pagination__header
              h3.h3 pagination
            +pagination

      .container.elements-inner-2
        .column 
          .dropdown-default.elements__item 
            .elements__item_header
              h3.h3 dropdown
              span.elements__item_state Default
            .card__input-wrapper
              .card__input-dropdown.card__input-filter-date 2 спальни, 2 кровати...
              span.material-icons.material-icons-expand.material-icons-expand-dark expand_more
          .dropdown-expanded.elements__item 
            .elements__item_header.elements__item_header-expanded
              h3.h3 dropdown
              span.elements__item_state expanded
            .card__input-wrapper_expanded-shadow 
              .card__input-wrapper.card__input-wrapper-expanded
                .card__input-dropdown.card__input-filter-date 2 спальни, 2 кровати...
                span.material-icons.material-icons-expand.material-icons-expand-dark expand_more
              .elements__item_content
                ul.dropdown-list 
                  li.dropdown-list__item 
                    .dropdown-list__item_name спальни
                    .dropdown-list__count 
                      .dropdown-list__count_minus -
                      .dropdown-list__count_number 2
                      .dropdown-list__count_plus +
                  li.dropdown-list__item 
                    .dropdown-list__item_name кровати
                    .dropdown-list__count 
                      .dropdown-list__count_minus -
                      .dropdown-list__count_number 2
                      .dropdown-list__count_plus +
                  li.dropdown-list__item 
                    .dropdown-list__item_name ванные комнаты
                    .dropdown-list__count 
                      .dropdown-list__count_minus.unactive-element -
                      .dropdown-list__count_number 0
                      .dropdown-list__count_plus +
        .colummn 
          .dropdown-expanded-guests.elements__item 
            .elements__item_header.elements__item_header-expanded
              h3.h3 dropdown
            .card__input-wrapper_expanded-shadow 
              +dropdown('dropdown-page', 'гости', 'Сколько гостей')
              .elements__item_content
                form(action="").dropdown-expanded-guests__form 
                  ul.dropdown-list.dropdown-expanded-guests__list 
                    li.dropdown-list__item 
                      .dropdown-list__item_name взрослые
                      .dropdown-list__count 
                        .dropdown-list__count_minus.unactive-element -
                        .dropdown-list__count_number 0
                        .dropdown-list__count_plus +
                    li.dropdown-list__item 
                      .dropdown-list__item_name дети
                      .dropdown-list__count 
                        .dropdown-list__count_minus.unactive-element -
                        .dropdown-list__count_number 0
                        .dropdown-list__count_plus +
                    li.dropdown-list__item 
                      .dropdown-list__item_name младенцы
                      .dropdown-list__count 
                        .dropdown-list__count_minus.unactive-element -
                        .dropdown-list__count_number 0
                        .dropdown-list__count_plus + 
                  .dropdown-btns 
                    button.dropdown__submit(type="submit") Применить 
        .column
          .dropdown-expanded-guests.elements__item 
            .elements__item_header.elements__item_header-expanded
              h3.h3 dropdown
            .card__input-wrapper_expanded-shadow 
              //- +dropdown('dropdown-page', 'гости', '3 гостя')
              .card__input-wrapper.card__input-wrapper-expanded
                .card__input-dropdown.card__input-filter-date 3 гостя
                span.material-icons.material-icons-expand.material-icons-expand-dark expand_more
              .elements__item_content
                form(action="").dropdown-expanded-guests__form 
                  ul.dropdown-list.dropdown-expanded-guests__list 
                    li.dropdown-list__item 
                      .dropdown-list__item_name взрослые
                      .dropdown-list__count 
                        .dropdown-list__count_minus -
                        .dropdown-list__count_number 2
                        .dropdown-list__count_plus +
                    li.dropdown-list__item 
                      .dropdown-list__item_name дети
                      .dropdown-list__count 
                        .dropdown-list__count_minus -
                        .dropdown-list__count_number 1
                        .dropdown-list__count_plus +
                    li.dropdown-list__item 
                      .dropdown-list__item_name младенцы
                      .dropdown-list__count 
                        .dropdown-list__count_minus.unactive-element -
                        .dropdown-list__count_number 0
                        .dropdown-list__count_plus + 
                  .dropdown-btns.dropdown-btns-2  
                    button.dropdown__submit(type="submit") Очистить 
                    button.dropdown__reset(type="reset") Применить 

      .container.elements-inner-3
        .column
          //- вынести в миксин
          .expandable-checkbox-list-default.elements__item
            .checkbox__header.elements__item_header
              h3.h3 expandable checkbox list
              span.material-icons.material-icons-expand expand_more
          .expandable-checkbox-list-expanded.elements__item
            .checkbox__header.elements__item_header
              h3.h3 expandable checkbox list
              span.material-icons.material-icons-expand.material-icons-expand-reverse expand_more
            //- сделать миксин
            ul.checkbox__list 
              li.checkbox__list_item 
                +checkbox('', 'breakfast', 'Завтрак')
              li.checkbox__list_item  
                +checkbox('', 'desk', 'Письменный стол')
              li.checkbox__list_item  
                +checkbox('', 'chair-for-feeding', 'Стул для кормления')
              li.checkbox__list_item  
                +checkbox('', 'crib', 'Кроватка')
              li.checkbox__list_item  
                +checkbox('', 'television', 'Телевизор')
              li.checkbox__list_item  
                +checkbox('', 'shampoo', 'Шампунь')
        .column  
          .rich-checkbox-buttons.elements__item 
            .checkbox-buttons__header.elements__item_header
              h3.h3 Rich Checkbox Buttons
            ul.checkbox__list 
              li.checkbox__list__item.rich-checkbox__list__item 
                +checkbox('checkbox__list__label-rich-title', 'corridor', 'Широкий коридор')
              .checkbox__list__label-rich-info Ширина коридоров в номере не менее 91 см.
              li.checkbox__list_item.rich-checkbox__list__item   
                +checkbox('checkbox__list__label-rich-title', 'assistant', 'Помощник для инвалидов')
              .checkbox__list__label-rich-info На 1 этаже вас встретит специалист и проводит до номера.
        .column 
          .bullet.elements__item 
            .elements__item_header
              h3.h3 bullet list
            +bullet-list('Нельзя с питомцами', 'Без вечеринок и мероприятий', 'Время прибытия — после 13:00, а выезд до 12:00')

      .container.elements-inner-4  
        .column
          .elements__item
            //- поменять классы
            +information('rd__information__item', require('@images/icons/insert_emoticon.png'), 'Комфорт', 'Шумопоглощающие стены')
            +information('rd__information__item', require('@images/icons/location_city.png'), 'Удобство', 'Окно в каждой из спален')
        .column-2  
          .reviews
            +review(require('@images/avatar-1.png'), 'Мурад Сарафанов', '5 дней назад', 'favorite', '12', 'Великолепный матрас на кровати в основной спальне! А пуфик вообще потрясающий. И стены, действительно, шумоподавляющие. Выкрикивал комплименты повару — никто не жаловался из соседей.')