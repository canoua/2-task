include includes.pug
+includes

doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(http-equiv="X-UA-Compatible", content="IE=edge")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title colors-types(ct)
  body 
    .ct 
      .ct__logo
        img(src=require("@images/ui-logo.svg"), alt="ui-logo")
      .container
        .ct-inner 
          .ct__box_1 
            +__color('Dark Shade 100%', '#1F2041', 'ct__color__square_1')
            +__color('Dark Shade 75%', '#1F2041', 'ct__color__square_2')
            +__color('Dark Shade 50%', '#1F2041', 'ct__color__square_3')
            +__color('Dark Shade 25%', '#1F2041', 'ct__color__square_4')
            +__color('Dark Shade 5%', '#1F204', 'ct__color__square_5')
            +__color('Purple', '#BC9CFF', 'ct__color__square_6')
            +__color('Green', '#6FCF97', 'ct__color__square_7')
          .ct__box_2 
            +__title('H1', '', 'This one is the sub-section or widget title', 'h1')
            +__title('H2', 'ct__title__number_2', 'Next one is the item title inside widgets', 'h2')
            +__title('H3', 'ct__title__number_3', 'This is a label or CTA text', 'h3')
            +__title('Body', 'ct__title__number_4', 'This is the body text which is used for most of the design, like paragraphs, lists, etc.', '')