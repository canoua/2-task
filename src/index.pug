extends @layouts/layout-page.pug

block title
  title Главная страница
  
block content 
  main.index
    article.index__block
      h2.index__title UI
      a.index__link(href="/pages/ui/headers-footers.html" target = "_blank") 
        span.index__link__text Шапки и подвалы (header-footers)
        img.index__img(src=require("@images/index/headers.jpg"), alt="headers")
      a.index__link(href="/pages/ui/form-elements(fe).html" target = "_blank") 
        span.index__link__text Элементы форм (form-elements)
        img.index__img(src=require("@images/index/form-elements.jpg"), alt="form-elements")
      a.index__link(href="/pages/ui/colors-types.html" target = "_blank")   
        span.index__link__text Цвета (colors-types) 
        img.index__img(src=require("@images/index/colors.jpg"), alt="colors")
      a.index__link(href="/pages/ui/cards.html" target = "_blank") 
        span.index__link__text Карточки (cards) 
        img.index__img(src=require("@images/index/cards.jpg"), alt="cards")
    article.index__block
      h2.index__title Страницы 
      a.index__link(href="/pages/app/sign-up.html" target = "_blank") 
        span.index__link__text Регистрация (sign-up)
        img.index__img(src=require("@images/index/sign-up.jpg"), alt="sign-up")
      a.index__link(href="/pages/app/sign-in.html" target = "_blank") 
        span.index__link__text Вход (sign-in)
        img.index__img(src=require("@images/index/sign-in.jpg"), alt="sign-in")
      a.index__link(href="/pages/app/landing.html" target = "_blank")  
        span.index__link__text Landing
        img.index__img(src=require("@images/index/landing.jpg"), alt="landing")
      a.index__link(href="/pages/app/search.html" target = "_blank")  
        span.index__link__text Search
        img.index__img(src=require("@images/index/search.jpg"), alt="search")
      a.index__link(href="/pages/app/room-details.html" target = "_blank") 
        span.index__link__text Room-details 
        img.index__img(src=require("@images/index/room-details.jpg"), alt="room-details")
