extends @layouts/layout-index.pug

block title
  title Главная страница
  
block content 
  - 
    const sections = [
      {
        title: 'UI',
        path: 'ui',
        items: [
          { href: 'headers-footers.html', title: 'Шапки и подвалы (header-footers)', imgSrc: 'headers.jpg'},
          { href: 'form-elements(fe).html', title: 'Элементы форм (form-elements)', imgSrc: 'form-elements.jpg'},
          { href: 'colors-types.html', title: 'Цвета (colors-types)', imgSrc: 'colors.jpg'},
          { href: 'cards.html', title: 'Карточки (cards)', imgSrc: 'cards.jpg'}
        ]
      },
      {
        title: 'Страницы',
        path: 'app',
        items: [
          { href: 'sign-up.html', title: 'Регистрация (sign-up)', imgSrc: 'sign-up.jpg'},
          { href: 'sign-in.html', title: 'Вход (sign-in)', imgSrc: 'sign-in.jpg'},
          { href: 'landing.html', title: 'Landing', imgSrc: 'landing.jpg'},
          { href: 'search.html', title: 'Search', imgSrc: 'search.jpg'},
          { href: 'room-details.html', title: 'Room-details', imgSrc: 'room-details.jpg'}
        ]
      }
    ];

  mixin pageCard(item, path)
    a.index__link(href=`/pages/${path}/${item.href}` target="_blank")
      span.index__link-text=item.title
      img.index__img(src=require(`@images/index/${item.imgSrc}`), alt=item.title)

  main.index
    each section in sections
      article.index__block
        h2.index__title=section.title
        each item in section.items
          +pageCard(item, section.path)