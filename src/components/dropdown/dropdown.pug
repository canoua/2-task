mixin dropdown(className, id, title, inputText)
  .dropdown(class=className)
    h3.h3.dropdown__title=title
    .input-wrapper.input-wrapper-js(id=id) 
      .input-dropdown.input-dropdown-pre-default=inputText
      span.material-icons.material-icons-expand expand_more

//- для страницы search 
mixin filter-date-dropdown(classes, title, date)
  .filter-date-dropdown(class=classes)
    h3.h3.filter-date-dropdown__title=title
    .input-wrapper
      input(type="text" name=classes placeholder=date).calendar
      span.material-icons.material-icons-expand(class=`${classes}__material-icons-expand`) expand_more

mixin date-dropdown(className, title, placeholder, name)
  .date-dropdown.date-dropdown-item.date-dropdown-item-box
    .date-dropdown__header
      h3.h3=title 
    .input-wrapper.calendar-input-wrapper
      input.calendar.input-date-dropdown(placeholder=placeholder class=className, name=name)
      span.material-icons.material-icons-expand(class=`${className}-material-icons-expand`) expand_more