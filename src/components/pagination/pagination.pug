mixin pagination 
  -
    const paginationList = [1, 2, 3, '...', 15]
  .pagination 
    .pagination__inner
      ul.pagination__list
        each item in paginationList
          li.pagination__list-item 
            a.pagination__link(href="#")=item
      a.pagination__link.pagination__arrow(href="#")
        span.material-icons.material-icons-pagination-arrow arrow_forward 
    p.pagination__info 1 – 12 из 100+ вариантов аренды