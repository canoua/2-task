include @components/buttons/buttons.pug
include @components/logo/logo.pug
include __menu/__menu.pug

mixin header(variable)  
  header(class=variable === 'header' ? 'header' : 'header header-2') 
    .container 
      .header__inner 
        .header__box
          +logo
        //- чтобы исключить дубль класса
        .header__box(class=variable === 'header' ? 'header__box_right' : 'header__box_right header-2__box_right')
          +__menu
          .burger 
            span 
            span 
            span 
          .mobile-menu 
            .btn-close x
            +__menu
            .header__buttons-wrapper 
              if variable=='header'  
                +button-white('header__btn-white','Войти')
                +button-gradient('header__btn-border','Зарегистрироваться')
              else if variable=='header-2'
                a(href="#").user 
                  span.user__name Юлий Цезарь
              else 
                p mixin failed
           
