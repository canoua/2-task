          .card-calculate__room
            span.card-calculate__room-icon №
            span.card-calculate__room-number 888
            span.card-calculate__room-class люкс
          .card-calculate__price
            span.card-calculate__price-values 9 990₽
            span.card-calculate__price-duration в сутки
        .card-calculate__date-dropdown-wrapper
          +date-dropdown('input1','прибытие', '19.08.2019', 'input1')
          +date-dropdown('input2','выезд', '23.08.2019', 'input2')
        .dropdown-page.dropdown-expanded-guests__form
          - 
            const guests = [
              {name: 'взрослые', count: 2},
              {name: 'дети', count: 1},
              {name: 'младенцы', count: 0}
            ]
            const sumCounts = guests[0].count + guests[1].count + guests[2].count 
          +dropdown('rd-dropdown cards-dropdown', 'rd-dropdown', 'гости', `${sumCounts} гостя`)
          .dropdown-content
            ul.dropdown-list.dropdown-expanded-guests__list  
              each guest in guests 
                li.dropdown-list__item 
                  .dropdown-list__item_name #{guest.name}
                  .dropdown-list__count 
                    .dropdown-list__count_minus.dropdown-list__count_minus-js -
                    .dropdown-list__count_number.dropdown__guests-list__count_number #{guest.count}
                    .dropdown-list__count_plus.dropdown-list__count_plus-js +
            .dropdown-btns.dropdown-btns-2  
              button.dropdown__reset(type="reset") Очистить 
              button.dropdown__submit(type="submit") Применить  
        .card-calculate__count-wrapper
          .card-calculate__count 
            span 9 990₽ х 4 суток
            span 39 960₽
          .card-calculate__count 
            span.card-calculate__count-info Сбор за услуги: скидка 2 179₽
            span 0₽
          .card-calculate__count 
            span.card-calculate__count-info Сбор за дополнительные услуги
            span 300₽
        .card-calculate__result 
          span.card-calculate__result-item Итого
          span.card-calculate__result-item 38 081₽
        +btn-gradient-arrow('card-btn-landing', 'забронировать')
        

mixin card-sign-up(page) 
  form(action="#" class=`card-form__${page} card-sign-up-form`) 
    .card.card-sign-up 
      .card-inner 
        h1(class = `card__title-${page}`).card__title Регистрация аккаунта
        .inputs-wrapper.card-sign-up__inputs-wrapper 
          +input('card-sign-up__name', 'Имя', 'firstname')
          +input('', 'Фамилия', 'lastname')
        +radiobuttons('')
        +text-field-masked('card-sign-up__date-birthday', 'дата рождения', 'ДД.ММ.ГГГГ', 'birthday-input')
        h3.h3.card__second-title данные для входа в сервис
        +input('card-sign-up__email', 'Email', 'lastname')
        +input('card-sign-up__password', 'Пароль', 'lastname')
        +toggle('card-sign-up__toggle', 'Получать спецпредложения')
        if (page=="sign-up")
          +btn-gradient-arrow('sign-up__submit', 'зарегистрироваться')
        else 
          +btn-gradient-arrow('', 'перейти к оплате')
        +card__note('sign-up')

mixin card-sign-in(page)
  form(action="#" class=`card-form__${page} card-sign-in-form`) 
    .card.card-sign-in
      .card-inner
        h1.card__title Войти
        .inputs-wrapper.card-sign-in__inputs-wrapper 
          +input(`${page}__input`, 'Email', 'firstname')
          +input(`${page}__input`, 'Пароль', 'lastname')
        +btn-gradient-arrow('button-default-big sign-in__submit', 'Войти')
        +card__note('sign-in')

mixin card__note(page)
  .card__note 
    if page == 'sign-up'
      span.card__note-info Уже есть аккаунт на Toxin
      +button-white(`card-btn-white ${page}__card-btn`, 'войти')
    else if page == 'sign-in' 
      span.card__note-info Нет аккаунта на Toxin?
      +button-white(`card-btn-white ${page}__card-btn`, 'Создать')