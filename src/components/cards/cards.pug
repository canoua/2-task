include @components/buttons/buttons.pug
include @components/text-field/text-field.pug
include @components/radiobuttons/radiobuttons.pug
include @components/toggle/toggle.pug

mixin card-sign-up(page) 
  form(action="#") 
    .card.card-sign-up 
      .card-inner 
        h1.card__title Регистрация аккаунта
        .inputs-wrapper.card-sign-up__inputs-wrapper 
          +text-field-default('', '', '', 'Имя')
          +text-field-default('', '', '', 'Фамилия')
        +radiobuttons('')
        +text-field-masked('card-sign-up__date-birthday', 'дата рождения', 'ДД.ММ.ГГГГ')
        +text-field-default('card-sign-up__email', 'данные для входа в сервис', '', 'Email')
        +text-field-default('card-sign-up__password', '', '', 'Пароль')
        +toggle('card-sign-up__toggle', 'Получать спецпредложения')
        if (page=="sign-up")
          +btn-gradient-arrow('sign-up__submit', 'зарегистрироваться')
        else 
          +btn-gradient-arrow('', 'перейти к оплате')
        +card__note('sign-up')

mixin card-sign-in
  form(action="#") 
    .card.card-sign-in
      .card-inner
        h1.card__title Войти
        .inputs-wrapper.card-sign-in__inputs-wrapper 
          +text-field-default('', '', '', 'Email')
          +text-field-default('', '', '', 'Пароль')
        +btn-gradient-arrow('button-default-big sign-in__submit', 'Войти')
        +card__note('sign-in')

mixin card__note(page)
  .card__note 
    if page == 'sign-up'
      span.card__note-info Уже есть аккаунт на Toxin
      +button-white('card-btn-white', 'войти')
    else if page == 'sign-in' 
      span.card__note-info Нет аккаунта на Toxin?
      +button-white('card-btn-white', 'Создать')