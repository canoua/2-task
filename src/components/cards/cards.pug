mixin card-room(src, luxe, number, price, rating, reviewsNumber) 
  .card.card-room
    .card-inner.card-room-inner
      .card-room__slider
        .slide.card-room__slide.card-room-arrow__slide   
          img(src=src, alt="slide").slide-1__img
        .pagination.card-room__pagination
          .dot.dot_active 
          .dot 
          .dot 
          .dot 
        .arrow-prev.material-icons expand_more
        .arrow-next.material-icons expand_more
      .card-room__content
        .card-room__content__header 
          h3.card-room__title 
            span.card-room__title__icon №
            span.card-room__title__number=number
            if (luxe)
              span.card-room__title-status люкс
          .card-room__price 
            .card-room__price__number=price 
            .card-room__price__text в сутки
        .card-room__content__footer 
          +stars-ratings(rating)
          .card-room__reviews 
            .card-room__reviews__number=reviewsNumber
            .card-room__reviews__text Отзывов

mixin card-landing 
  form(action="#")
    .card.card-landing 
      .card-inner  
        h1.card__title Найдём номера под ваши пожелания
        .card-landing__date-dropdown-wrapper
          +date-dropdown('input1','прибытие', 'ДД.ММ.ГГГГ', 'input1')
          +date-dropdown('input2','выезд', 'ДД.ММ.ГГГГ', 'input2')
        .dropdown-page.dropdown-expanded-guests__form
          - 
            const guests = [
              {name: 'взрослые', count: 2},
              {name: 'дети', count: 1},
              {name: 'младенцы', count: 0},
            ]
            let sumCount = function() {
              let sum = 0;
              for(let i=0; i<guests.length; i++) {
                sum += guests[i].count;
              }
              return sum
            }
          +dropdown('card-landing__dropdown card-landing__dropdown-js', 'card-landing__dropdown',  'гости', `${sumCount()} гостя`)
          .dropdown-content
            ul.dropdown-list.dropdown-expanded-guests__list  
              each guest in guests 
                li.dropdown-list__item 
                  .dropdown-list__item_name #{guest.name}
                  .dropdown-list__count 
                    .dropdown-list__count_minus.dropdown-list__count_minus-js -
                    .dropdown-list__count_number.dropdown__guests-list__count_number #{guest.count}
                    .dropdown-list__count_plus.dropdown-list__count_plus-js +
            .dropdown-btns.dropdown-btns-2  
              button.dropdown__reset(type="reset") Очистить 
              button.dropdown__submit(type="submit") Применить  
        +btn-gradient-arrow('card-btn-landing', 'подобрать номер')
  

