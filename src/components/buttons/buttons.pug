mixin button-gradient(btnGradientClass,textGradient)
  if textGradient=='Зарегистрироваться'
    a(href="/pages/sign-up.html" class=btnGradientClass target='_about').button.button-default
      span=textGradient
  else 
    //-для страницы form-elements
    button(class=btnGradientClass).button.button-default=textGradient
mixin btn-gradient-arrow(classes, textGradBtn)
  button.button-default-big(class=classes)
    span=textGradBtn
    .material-icons.material-icons-arrow_forward arrow_forward 

mixin like-button(classIcon, nameBtn, icon, text, textColor)   
  - var color = textColor
  .like-button__item(class=nameBtn) 
    span(class=classIcon).material-icons.like-icon=icon
    span.like-button__item-text(style={color: color})=text

mixin button-white(btnClass,text)
  if text=='Войти'
    a(href='/pages/sign-in.html' class=btnClass target='_about').button.button-border-color
      span=text
  else 
    //-для страницы form-elements
    button(class=btnClass).button.button-border
      span=text 
