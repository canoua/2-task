mixin __information
  article.rd__information
    h2.title.rd__title Сведения о номере
    - 
      const rdInformationItems = [
        {img:'insert_emoticon.png', title: 'Комфорт', text: 'Шумопоглощающие стены'},
        {img:'location_city.png', title: 'Удобство', text: 'Окно в каждой из спален'},
        {img:'whatshot.png', title: 'Уют', text: 'Номер оснащён камином'}
      ];
    each rdInformationItem in rdInformationItems
      .rd__information__item.information__item 
        img.information__icon(src=require(`@images/pages/room-details/information/${rdInformationItem.img}`), alt="icon")
        .information__item-inner 
          .information__title #{rdInformationItem.title}
          .information__text #{rdInformationItem.text}