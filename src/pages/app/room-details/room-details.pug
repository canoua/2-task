extends @layouts/layout-app.pug

include __header/__header.pug
include __pie/__pie.pug
include __information/__information.pug
include @components/review/review.pug
include @components/bullet-list/bullet-list.pug
include @components/cards/cards.pug

block title 
  title Room-details(rd)
  
  - bodyClass = 'page'
  - bodyId = 'room-details-js '

block content  
  header.rd 
    +__header()
  main.rd__main 
    .container
      .rd__info-inner 
        .rd__col_1
          .rd__block.rd__content 
            article.rd__information
              h2.title.rd__title Сведения о номере
              +__information()
            article.rd__impression
              h2.title.rd__title Впечатления от номера
              .rd__impression-inner 
                +__pie()
                ul.impression__list
                  - 
                    var impressionList = [
                      {name: 'Великолепно', class: 'impression__list_item-1'},
                      {name: 'Хорошо', class: 'impression__list_item-2'},
                      {name: 'Удовлетворительно', class: 'impression__list_item-3'},
                      {name: 'Разочарован', class: 'impression__list_item-4'}];
                  each impressionListItem in impressionList
                    li.impression__list_item(class=impressionListItem.class) #{impressionListItem.name}
          
          .rd__block.rd__reviews
            - 
              const reviewList = [
                { src: 'avatar-1.png', id: '', name: 'Мурад Сарафанов', date: '5 дней назад', icon: 'favorite', iconText: '12', comment: 'Великолепный матрас на кровати в основной спальне! А пуфик вообще потрясающий. И стены, действительно, шумоподавляющие. Выкрикивал комплименты повару — никто не жаловался из соседей.'},
                { src: 'avatar-2.png', id: 'avatar-2', name: 'Патрисия Стёклышкова', date: 'Неделю назад', icon: 'favorite_border', iconText: '2', comment: 'Обслуживание на высоте! Всё аккуратно, чисто. Завтраки в номер советую заказать, каждый день новое блюдо и десерт как комплимент'}
              ]
            h2.title.rd__title.rd__reviews__title
              span Отзывы посетителей номера
              span.reviews__title-info #{reviewList.length} отзыва
            each item in reviewList
              +review(require(`@images/pages/room-details/${item.src}`), item.id, item.name, item.date, item.icon, item.iconText, item.comment)
          .rd__block.rd__regulations 
            article.rd__regulations__item
              h2.title.rd__title Правила
              +bullet-list('Нельзя с питомцами', 'Без вечеринок и мероприятий', 'Время прибытия — после 13:00, а выезд до 12:00')
            article.rd__regulations__item.rd__regulations__item_cancellation 
              h2.title.rd__title.rd__title_cancel Отмена
              .cancellation__text Бесплатная отмена в течение 48 ч. После этого при отмене не позднее чем за 5 дн. до прибытия вы получите полный возврат за вычетом сбора за услуги. 
        .rd__col_2
          +card-calculate('rd__card')