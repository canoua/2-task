extends @layouts/layout-app.pug


include @components/cards/cards.pug
include __header/__header.pug
include __content/__content.pug
include __reviews/__reviews.pug
include __regulations/__regulations.pug

block title 
  title Room-details(rd)
  
  - bodyClass = 'page'
  - bodyId = 'room-details-js '

block content  
  header.rd 
    +__header()
  main.rd__main 
    .container
      .rd__info-inner 
        .rd__col_1
          +__content()         
          +__reviews()
          +__regulations()
        .rd__col_2
          +card-calculate('rd__card')