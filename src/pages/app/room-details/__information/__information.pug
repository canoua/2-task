mixin __information
  article.rd__information
    h2.title.rd__info-title Сведения о номере
    - 
      const rdInformationItems = [
        {img:'@images/icons/insert_emoticon.png', title: 'Комфорт', text: 'Шумопоглощающие стены'},
        {img:'@images/icons/location_city.png', title: 'Удобство', text: 'Окно в каждой из спален'},
        {img:'@images/icons/whatshot.png', title: 'Уют', text: 'Номер оснащён камином'}
      ];
    each rdInformationItem in rdInformationItems
      .rd__information__item 
        img.information__icon(src=require(rdInformationItem.img), alt="icon")
        .information__item-inner 
          .information__title #{rdInformationItem.title}
          .information__text #{rdInformationItem.text}