mixin __dropdown-convenience
  ul.dropdown-list.dropdown-expanded-guests__list 
    - 
      let dropdownConvenienceList = [
        {name: 'спальни', class: 'dropdown__convenience-list__count_bedrooms'},
        {name: 'кровати', class: 'dropdown__convenience-list__count_beds'},
        {name: 'ванные комнаты', class: 'dropdown__convenience-list__count_bathrooms'}
      ]
    each dropdownConvenienceListItem in dropdownConvenienceList
      li.dropdown-list__item 
        .dropdown-list__item_name #{dropdownConvenienceListItem.name}
        .dropdown-list__count 
          .dropdown-list__count_minus.dropdown__convenience-list__count_minus -
          .dropdown-list__count_number.dropdown__convenience-list__count_number(class=dropdownConvenienceListItem.class)
          .dropdown-list__count_plus.dropdown__convenience-list__count_plus +