mixin __sidebar
  .search__sidebar 
    +filter-date-dropdown('search__filter-date-dropdown', 'даты пребывания в отеле', '')
    +input('search-input-calendar', '', '', '')
    .dropdown-page.dropdown-expanded-guests__form
      - 
        const dropdownExpandedGuestsList = [
          {name:'взрослые', number: 2}, 
          {name:'дети', number: 0},
          {name:'младенцы', number: 1}];
        //- перенести в js 
        let sumCount = function() {
          let sum = 0;
          for(let i=0; i<dropdownExpandedGuestsList.length; i++) {
            sum += dropdownExpandedGuestsList[i].number;
          }
          return sum
        }
      +dropdown('card-landing__dropdown dropdown card-landing__dropdown-js', 'dropdown-guests', 'гости', `${sumCount()} гостя, ${dropdownExpandedGuestsList[2].number} младенец`)
      .dropdown-content
        ul.dropdown-list.dropdown-expanded-guests__list  
          each dropdownExpandedGuestsListItem in dropdownExpandedGuestsList
            li.dropdown-list__item 
              .dropdown-list__item_name #{dropdownExpandedGuestsListItem.name}
              .dropdown-list__count 
                .dropdown-list__count_minus.dropdown-list__count_minus-js -
                .dropdown-list__count_number.dropdown__guests-list__count_number #{dropdownExpandedGuestsListItem.number}
                .dropdown-list__count_plus.dropdown-list__count_plus-js +
        .dropdown-btns.dropdown-btns-2  
          button.dropdown__reset(type="reset") Очистить 
          button.dropdown__submit(type="submit") Применить 
    .search__range 
      +range-slider('', 'диапазон цены')
      span.search__range__info Стоимость за сутки пребывания в номере
    .search__checkbox 
      h3.h3.search__checkbox__title правила дома
      ul.checkbox__list 
        - 
          const searchCheckboxList = [
            { class: '', id: 'smoking', text1: 'Можно курить', text2: '' },
            { class: '', id: 'pets', text1: 'Можно с питомцами', text2: '' },
            { class: '', id: 'guests', text1: 'Можно пригласить гостей ', text2: '(до 10 человек)' }
          ]
        each item in searchCheckboxList
          li.checkbox__list_item.search__checkbox-list-item  
            +checkbox(item.class, item.id, item.text1, item.text2)
    .search__rich-checkbox 
      h3.h3.search__rich-checkbox__title доступность
      ul.checkbox__list 
        - 
          const richCheckboxList = [
            { class: 'checkbox__list-label-rich-title', id: 'corridor', text1: 'Широкий коридор', text2: '', info: 'Ширина коридоров в номере не менее 91 см.' },
            { class: 'checkbox__list-label-rich-title', id: 'assistant', text1: 'Помощник для инвалидов', text2: '', info: 'На 1 этаже вас встретит специалист и проводит до номера.' },
          ]
        each item in richCheckboxList
          li.checkbox__list__item.search__rich-checkbox__list__item 
            +rich-checkbox(item.class, item.id, item.text1, item.text2, item.info)
    .dropdown-page.search__dropdown-convenience
      +dropdown('dropdown-convenience', 'dropdown-convenience', 'удобства номера', 'text')
      .dropdown-content.dropdown-convenience__content.search__dropdown-convenience__content
        +__dropdown-convenience()
    .expandable-checkbox-list-default.elements__item
      .search__expandable-checkbox-list.checkbox__header.elements__item_header
        h3.h3 дополнительные удобства
        span.material-icons.material-icons-expand expand_more
      ul.checkbox__list.expandable-checkbox-list.search__checkbox-list 
        -
          const expandableCheckboxList = [
            { class: '', id: 'breakfast', text1: 'Завтрак', text2: '' },
            { class: '', id: 'desk', text1: 'Письменный стол', text2: '' },
            { class: '', id: 'chair-for-feeding', text1: 'Стул для кормления', text2: '' },
            { class: '', id: 'crib', text1: 'Кроватка', text2: '' },
            { class: '', id: 'television', text1: 'Телевизор', text2: '' },
            { class: '', id: 'shampoo', text1: 'Шампунь', text2: '' }
          ]
        each item in expandableCheckboxList
          li.checkbox__list_item 
            +checkbox(item.class, item.id, item.text1)