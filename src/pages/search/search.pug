include includes.pug 
+includes

doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Search room
  body 
    +header 
    main.search
      .container 
        .search-inner 
          .search__sidebar 
            +filter-date-dropdown('search__filter-date-dropdown', 'даты пребывания в отеле', '19 авг - 23 авг')
            +dropdown('search__dropdown', 'гости', '3 гостя, 1 младенец')
            .search__range 
              +range-slider('', 'диапазон цены')
              span.search__range__info Стоимость за сутки пребывания в номере
            .search__checkbox 
              h3.h3.search__checkbox__title правила дома
              ul.checkbox__list 
                li.checkbox__list_item 
                  +checkbox('', 'smoking', 'Можно курить')
                li.checkbox__list_item  
                  +checkbox('', 'pets', 'Можно с питомцами')
                li.checkbox__list_item 
                  +checkbox('', 'guests', 'Можно пригласить гостей (до 10 человек)') 
            .search__rich-checkbox 
              h3.h3.search__rich-checkbox__title доступность
              ul.checkbox__list 
                li.checkbox__list__item.rich-checkbox__list__item 
                  +checkbox('checkbox__list__label-rich-title', 'corridor', 'Широкий коридор')
                .checkbox__list__label-rich-info Ширина коридоров в номере не менее 91 см.
                li.checkbox__list_item.rich-checkbox__list__item   
                  +checkbox('checkbox__list__label-rich-title', 'assistant', 'Помощник для инвалидов')
                .checkbox__list__label-rich-info На 1 этаже вас встретит специалист и проводит до номера.
            +dropdown('search__dropdown', 'удобства номера', '2 спальни, 2 кровати...')
            //- миксин
            .expandable-checkbox-list-default.elements__item
              .checkbox__header.elements__item_header
                h3.h3 дополнительные удобства
                span.material-icons.material-icons-expand expand_more
              ul.checkbox__list.expandable-checkbox-list.search__checkbox__list 
                li.checkbox__list_item 
                  +checkbox('', 'breakfast', 'Завтрак')
                li.checkbox__list_item  
                  +checkbox('', 'desk', 'Письменный стол')
                li.checkbox__list_item  
                  +checkbox('', 'chair-for-feeding', 'Стул для кормления')
                li.checkbox__list_item  
                  +checkbox('', 'crib', 'Кроватка')
                li.checkbox__list_item  
                  +checkbox('', 'television', 'Телевизор')
                li.checkbox__list_item  
                  +checkbox('', 'shampoo', 'Шампунь')
          .search__content
            .search__title Номера, которые мы для вас подобрали
            .search__content__rooms
              +card-room-arrow
              +card-room
              +card-room
              +card-room
              +card-room
              +card-room
              +card-room
              +card-room
              +card-room
              +card-room
              +card-room
              +card-room
            .search__content__pagination
              +pagination
    +footer