include includes.pug 
+includes

doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Search room
  body.page 
    +header('header') 
    main.search.app-js-dropdown
      .container 
        .search-inner 
          +__sidebar
          .search__content
            .search__title Номера, которые мы для вас подобрали
            .search__content__rooms
              //-вынести в массив 
              +card-room-arrow
              +card-room(require('@images/cards/slide-1.png'), 840, 9900, 4, 65)
              +card-room(require('@images/search-page/3.jpg'), 980, 8500, 3, 35)
              +card-room(require('@images/search-page/4.png'), 856, 7300, 5, 19)
              +card-room(require('@images/search-page/5.png'), 740, 6000, 4, 44)
              +card-room(require('@images/search-page/6.png'), 982, 5800, 3, 56)
              +card-room(require('@images/search-page/7.png'), 678, 5500, 5, 45)
              +card-room(require('@images/search-page/8.png'), 450, 5300, 4, 39)
              +card-room(require('@images/search-page/9.png'), 350, 5000, 3, 77)
              +card-room(require('@images/search-page/10.png'), 666, 5000, 5, 25)
              +card-room(require('@images/search-page/11.png'), 444, 5000, 3, 15)
              +card-room(require('@images/search-page/12.png'), 352, 5000, 3, 55)
            .search__content__pagination
              +pagination
    +footer
    +footer-mobile