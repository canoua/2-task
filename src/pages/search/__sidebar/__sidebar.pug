mixin __sidebar
  .search__sidebar 
    +filter-date-dropdown('search__filter-date-dropdown', 'даты пребывания в отеле', '19 авг - 23 авг')
    .dropdown-page.dropdown-expanded-guests__form
      - 
        const dropdownExpandedGuestsList = [
          {name:'взрослые', number: 2}, 
          {name:'дети', number: 0},
          {name:'младенцы', number: 1}];
        //- перенести в js 
        let sumCount = function() {
          let sum = 0;
          for(let i=0; i<dropdownExpandedGuestsList.length; i++) {
            sum += dropdownExpandedGuestsList[i].number;
          }
          return sum
        }
      +dropdown('card-landing__dropdown dropdown-convenience dropdown card-landing__dropdown-js', 'dropdown-guests', 'гости', `${sumCount()} гостя, ${dropdownExpandedGuestsList[2].number} младенец`)
      .fe__dropdown-content
        ul.dropdown-list.dropdown-expanded-guests__list  
          each dropdownExpandedGuestsListItem in dropdownExpandedGuestsList
            li.dropdown-list__item 
              .dropdown-list__item_name #{dropdownExpandedGuestsListItem.name}
              .dropdown-list__count 
                .dropdown-list__count_minus.dropdown-list__count_minus-js -
                .dropdown-list__count_number.dropdown__guests-list__count_number #{dropdownExpandedGuestsListItem.number}
                .dropdown-list__count_plus.dropdown-list__count_plus-js +
        .dropdown-btns.dropdown-btns-2  
          button.dropdown__reset(type="reset") Очистить 
          button.dropdown__submit(type="submit") Применить 
    .search__range 
      +range-slider('', 'диапазон цены')
      span.search__range__info Стоимость за сутки пребывания в номере
    .search__checkbox 
      h3.h3.search__checkbox__title правила дома
      ul.checkbox__list 
        li.checkbox__list_item.search__checkbox-list-item  
          +checkbox('', 'smoking', 'Можно курить')
        li.checkbox__list_item.search__checkbox-list-item    
          +checkbox('', 'pets', 'Можно с питомцами')
        li.checkbox__list_item.search__checkbox-list-item   
          +checkbox('', 'guests', 'Можно пригласить гостей ', '(до 10 человек)') 
    .search__rich-checkbox 
      h3.h3.search__rich-checkbox__title доступность
      ul.checkbox__list 
        li.checkbox__list__item.search__rich-checkbox__list__item 
          +rich-checkbox('checkbox__list-label-rich-title', 'corridor', 'Широкий коридор', '', 'Ширина коридоров в номере не менее 91 см.')
        li.checkbox__list_item.search__rich-checkbox__list__item   
          +rich-checkbox('checkbox__list-label-rich-title', 'assistant', 'Помощник для инвалидов', '',  'На 1 этаже вас встретит специалист и проводит до номера.')
    //- переделать, в миксин?
    .dropdown-page.search__dropdown-convenience
      +dropdown('dropdown-convenience', 'dropdown-convenience', 'удобства номера', 'text')
      .fe__dropdown-content.dropdown-convenience__content.search__dropdown-convenience__content
        +dropdown-convenience
    //- миксин
    .expandable-checkbox-list-default.elements__item
      .search__expandable-checkbox-list.checkbox__header.elements__item_header
        h3.h3 дополнительные удобства
        span.material-icons.material-icons-expand expand_more
      ul.checkbox__list.expandable-checkbox-list.search__checkbox-list 
        li.checkbox__list_item 
          +checkbox('', 'breakfast', 'Завтрак')
        li.checkbox__list_item  
          +checkbox('', 'desk', 'Письменный стол')
        li.checkbox__list_item  
          +checkbox('', 'chair-for-feeding', 'Стул для кормления')
        li.checkbox__list_item  
          +checkbox('', 'crib', 'Кроватка')
        li.checkbox__list_item  
          +checkbox('', 'television', 'Телевизор')
        li.checkbox__list_item  
          +checkbox('', 'shampoo', 'Шампунь')