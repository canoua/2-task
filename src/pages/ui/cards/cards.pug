extends @layouts/layout-ui.pug

include @components/cards/cards.pug

block title 
  title Cards

block content
  body
    .ui-cards 
      .container 
        .ui-cards__logo
          img(src=require("@images/components/ui-logo.svg"), alt="ui-logo")
        .ui-cards-inner 
          .col.col_1
            .ui-card
              +card-landing
            .ui-card
              +card-sign-up("cards")
          .col.col_2
            .ui-card 
              +card-calculate
            .ui-card
              +card-sign-in
          .col.col_3
            .ui-card 
              +card-calendar
            .ui-card 
              +card-room(require('@images/pages/cards/slide-1.png'), true, 888, '9 990₽', 5, 145, 'cards')
            .ui-card  
              +card-room(require('@images/pages/cards/slide-2.png'), false, 840, '9 900₽', 4, 65)
