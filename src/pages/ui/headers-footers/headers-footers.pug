extends @layouts/layout-ui.pug

include @components/header/header.pug
include @components/footer/footer.pug

block title
  title headers and footers

block content  
  .headers-footers
    .container.headers-footers__container 
      img(src=require("@images/components/ui-logo.svg"), alt="ui-logo").headers-footers__logo 
    .headers-footers__box 
      +header('header') 
    .headers-footers__box 
      +header('header-2')
    .headers-footers__box
      +footer()
    .headers-footers__box
      +footer-mobile()
      