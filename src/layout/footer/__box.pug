include ../../modules/text-field/text-field.pug
include ../../modules/list/list.pug

mixin __item(title, ...items)
  .footer__box__item 
    h3.footer__title=title
    nav.footer__navigation
      +list-a(...items)
      
mixin __box
  .footer__box 
    .container 
      .footer-inner
        .footer__info
          .footer__logo 
            +logo
          span.footer__info__block Бронирование номеров в лучшем <br> отеле 2019 года по версии <br> ассоциации «Отельные взгляды»
        //- вывести циклом - 08.07
        +__item('навигация', 'О нас', 'Новости', 'Служба поддержки', 'Услуги')
        +__item('о нас', 'О сервисе', 'Наша команда', 'Вакансии', 'Инвесторы')
        +__item('Служба поддержки', 'Соглашения', 'Сообщества', 'Связь с нами')
        .footer__box__item 
          h3.footer__title Подписка
          .footer__box__item__info Получайте специальные предложения и новости сервиса
          //-сделать миксином
          +subscription-text-field('', 'Email')