include ../../modules/buttons/buttons.pug
include ../modules/menu/menu.pug
include ../modules/logo/logo.pug

mixin header(variable)  
  header(class=variable === 'header' ? 'header' : 'header header-2') 
    .container 
      .header__inner 
        .header__box
          +logo
        //- чтобы исключить дубль класса
        .header__box(class=variable === 'header' ? 'header__box_right' : 'header__box_right header-2__box_right')
          +menu
          .burger 
            span 
            span 
            span 
          .header__buttons-wrapper 
            if variable=='header'  
              +button-white('form-element-btn','Войти')
              +button-gradient('form-element-btn','Зарегистрироваться')
            else if variable=='header-2'
              a(href="#").user 
                span.user__name Юлий Цезарь
            else 
              p mixin failed
        