include ../../modules/buttons/buttons.pug
include ../modules/menu/menu.pug
include ../modules/logo/logo.pug

mixin header(variable)  
  header.header(class=variable) 
    .container 
      .header-inner 
        .header__box
          +logo
        .header__box.header__box_right
          +menu
          if variable=='header'  
            +button-white('form-element-btn','Войти')
            +button-gradient('form-element-btn','Зарегистрироваться')
          else if variable=='header-2'
            a(href="#").user 
              span.user__name Юлий Цезарь
          else 
            p mixin failed
        