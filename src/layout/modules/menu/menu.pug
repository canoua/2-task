mixin menu
  nav.menu__navigation&attributes(attributes)
    ul.list 
      -
        const lists = [
          { name: 'О нас', link: '#' }, 
          { name: 'Услуги', link: '#', drop: true },
          { name: 'Вакансии', link: '#' }, 
          { name: 'Новости', link: '#' },
          { name: 'Соглашения', link: '#', drop: true},];
      each listItem in lists
        li.list__item
          if !listItem.drop
            a.list__link(href=listItem.link) #{listItem.name}
          else
            a.list__link.list__link_drop(href="#") 
              span.drop-link  #{listItem.name}
              span.material-icons.material-icons-expand.material-icons-expand-menu expand_more